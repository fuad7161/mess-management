rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.active == true;
    }

    function isAdmin(groupId) {
      return isMember(groupId) &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function monthFinalized(groupId, month) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/monthlySummary/$(month)) &&
        (get(/databases/$(database)/documents/groups/$(groupId)/monthlySummary/$(month)).data.finalized == true ||
         get(/databases/$(database)/documents/groups/$(groupId)/monthlySummary/$(month)).data.closing == true);
    }

    function myGroupId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.currentGroupId;
    }

    function validMeal(groupId, mealId) {
      let data = request.resource.data;
      let weights = get(/databases/$(database)/documents/groups/$(groupId)).data.mealWeights;
      return data.keys().hasOnly(['uid', 'date', 'breakfast', 'lunch', 'dinner', 'guestMeals', 'weightsUsedSnapshot', 'updatedAt']) &&
        data.uid == request.auth.uid &&
        mealId == request.auth.uid + '_' + data.date &&
        data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.breakfast is bool && data.lunch is bool && data.dinner is bool &&
        data.guestMeals is int && data.guestMeals >= 0 && data.guestMeals <= 20 &&
        data.weightsUsedSnapshot is map &&
        data.weightsUsedSnapshot.breakfast is number && data.weightsUsedSnapshot.lunch is number && data.weightsUsedSnapshot.dinner is number &&
        data.updatedAt == request.time &&
        !monthFinalized(groupId, data.date[0:7]) &&
        (resource == null || (
          data.uid == resource.data.uid && data.date == resource.data.date &&
          data.weightsUsedSnapshot == resource.data.weightsUsedSnapshot
        )) &&
        (resource != null || data.weightsUsedSnapshot == weights);
    }

    // ---------- users/{uid} ----------
    // createUserProfile runs via Cloud Function (Admin SDK), but allow the owner
    // to read/update their own basic profile fields directly.
    match /users/{uid} {
      allow read: if isSelf(uid) || (isSignedIn() && resource.data.currentGroupId != null && myGroupId() == resource.data.currentGroupId);
      allow create, update: if false;
      allow delete: if false;
    }

    // ---------- groups/{groupId} ----------
    match /groups/{groupId} {
      // Anyone signed in can read group docs (needed for searchGroups results, join flow).
      allow read: if isSignedIn();
      // All mutations (create/adminCount/memberCount/mealWeights/status) go through
      // Cloud Functions (createGroup, updateMealWeights, deleteGroup, etc.) using Admin SDK.
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(groupId);
        // Membership changes (join approval, promote/demote, leave) are Cloud Function only.
        allow write: if false;
      }

      match /joinRequests/{requestUid} {
        allow read: if isAdmin(groupId) || isSelf(requestUid);
        allow write: if false;
      }

      match /meals/{mealId} {
        allow read: if isMember(groupId);
        // meals/{uid}_{date} — user can only write their own doc, and only if that
        // month isn't finalized yet. mealId format: "{uid}_{yyyy-mm-dd}".
        allow create, update: if isMember(groupId) && validMeal(groupId, mealId);
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isMember(groupId);
        // submitExpense enforces the adminCount>=2 gate and approveExpense enforces
        // no-self-approval — both server-side. Client cannot write directly.
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if isMember(groupId);
        allow write: if false; // via submitExpense/approveExpense-style Cloud Functions
      }

      match /monthlySummary/{month} {
        allow read: if isMember(groupId);
        allow write: if false; // written only by triggers / finalizeMonth
      }
    }
  }
}
