{
  "expo": {
    "name": "MessApp",
    "slug": "MessApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.messapp.management",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ]
  }
}
